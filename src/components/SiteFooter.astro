---
import { footer } from '../content/site';
---

<footer class="site-footer">
  <a href="/" class="footer-logo-link">
    <img src="/logo-excelerate.png" alt="excelerate Roth" class="footer-logo" />
  </a>
  <span class="tagline">{footer.tagline}</span>
  <div class="footer-links">
    <a href={footer.impressum.href}>{footer.impressum.label}</a>
    <a href={footer.datenschutz.href}>{footer.datenschutz.label}</a>
    <span>{footer.copyright}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--sand);
    padding: 40px var(--page-padding);
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }

  .footer-logo-link {
    display: block;
  }

  .footer-logo {
    height: 34px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .tagline {
    font-size: 15px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    font-size: 14px;
    color: var(--warmgrey);
  }

  .footer-links a {
    color: var(--warmgrey);
  }

  .footer-links a:hover {
    color: var(--sand);
  }
</style>
