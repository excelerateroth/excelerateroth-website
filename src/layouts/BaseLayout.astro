---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import * as de from '../content/site';
import * as en from '../content/site.en';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  activePage?: 'ueber-mich' | 'offerte' | 'kontakt' | 'none';
  lang?: 'de' | 'en';
  langSwitchHref: string;
}

const { title, description, activePage = 'none', lang = 'de', langSwitchHref } = Astro.props;
const t = lang === 'en' ? en : de;
const homeHref = lang === 'en' ? '/en/' : '/';
const htmlLang = lang === 'en' ? 'en' : 'de-CH';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <link rel="icon" type="image/png" href="/logo-excelerate.png" />
  </head>
  <body>
    <div class="page">
      <SiteHeader nav={t.nav} homeHref={homeHref} activePage={activePage} lang={lang} langSwitchHref={langSwitchHref} />
      <main>
        <slot />
      </main>
      <SiteFooter footer={t.footer} homeHref={homeHref} />
    </div>
  </body>
</html>

<style is:global>
  /* overflow-x:hidden bewusst nicht auf .page (Sticky-Header-Vorfahre) gesetzt —
     das würde position:sticky in vielen Browsern brechen. Stattdessen auf html,
     dem Wurzel-Scroll-Container, wo Sticky-Elemente davon unberührt bleiben. */
  html {
    overflow-x: hidden;
  }

  .page {
    width: 100%;
  }
</style>
