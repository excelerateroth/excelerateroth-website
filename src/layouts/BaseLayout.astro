---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import * as de from '../content/site';
import * as en from '../content/site.en';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  activePage?: 'ueber-mich' | 'offerte' | 'kontakt' | 'none';
  lang?: 'de' | 'en';
  langSwitchHref: string;
}

const { title, description, activePage = 'none', lang = 'de', langSwitchHref } = Astro.props;
const t = lang === 'en' ? en : de;
const homeHref = lang === 'en' ? '/en/' : '/';
const htmlLang = lang === 'en' ? 'en' : 'de-CH';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Schema.org-Markup (JSON-LD) — identifiziert Unternehmen und Person site-weit,
// unabhängig von der Sprache der jeweiligen Seite.
const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': 'https://www.excelerateroth.ch/#business',
      name: 'excelerate Roth',
      url: 'https://www.excelerateroth.ch/',
      email: 'jennifer.roth@excelerateroth.ch',
      telephone: '+41765311610',
      description:
        'Reporting- und Controlling-Strukturen für Schweizer KMU – mit Power BI oder einer klar aufgebauten Excel-Lösung.',
      areaServed: {
        '@type': 'Country',
        name: 'Schweiz',
      },
      founder: { '@id': 'https://www.excelerateroth.ch/#jennifer' },
      sameAs: ['https://www.linkedin.com/in/jennifer-roth-excelerate'],
    },
    {
      '@type': 'Person',
      '@id': 'https://www.excelerateroth.ch/#jennifer',
      name: 'Jennifer Roth',
      jobTitle: 'Controlling & BI-Beraterin',
      url: 'https://www.excelerateroth.ch/ueber-mich/',
      worksFor: { '@id': 'https://www.excelerateroth.ch/#business' },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'WINGS Hochschule Wismar',
      },
      sameAs: ['https://www.linkedin.com/in/jennifer-roth-excelerate'],
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <link rel="icon" type="image/png" href="/logo-excelerate.png" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body>
    <div class="page">
      <SiteHeader nav={t.nav} homeHref={homeHref} activePage={activePage} lang={lang} langSwitchHref={langSwitchHref} />
      <main>
        <slot />
      </main>
      <SiteFooter footer={t.footer} homeHref={homeHref} />
    </div>
  </body>
</html>

<style is:global>
  /* overflow-x:hidden bewusst nicht auf .page (Sticky-Header-Vorfahre) gesetzt —
     das würde position:sticky in vielen Browsern brechen. Stattdessen auf html,
     dem Wurzel-Scroll-Container, wo Sticky-Elemente davon unberührt bleiben. */
  html {
    overflow-x: hidden;
  }

  .page {
    width: 100%;
  }
</style>
