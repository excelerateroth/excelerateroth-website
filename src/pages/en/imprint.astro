---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { impressum } from '../../content/site.en';
---

<BaseLayout
  title={impressum.meta.title}
  description={impressum.meta.description}
  activePage="none"
  lang="en"
  langSwitchHref="/impressum"
>
  <section class="legal-section">
    <div class="text-column">
      <h1>{impressum.heading}</h1>

      <p>
        <strong>excelerate Roth | Jennifer Roth</strong><br />
        Rheinstrasse 5A<br />
        8280 Kreuzlingen<br />
        Switzerland
      </p>

      <p>
        Phone: <a href="tel:+41765311610">+41 76 531 16 10</a><br />
        Email: <a href="mailto:jennifer.roth@excelerateroth.ch">jennifer.roth@excelerateroth.ch</a>
      </p>

      <p>
        Sole proprietorship. Not registered in the Commercial Register. Not subject to VAT,
        therefore no UID number.
      </p>

      <p>Responsible for the content of this website: Jennifer Roth (address as above).</p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-section {
    padding: var(--section-padding-y) var(--page-padding) clamp(56px, 8vw, 110px);
  }

  .text-column {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .text-column h1 {
    font-size: clamp(30px, 4.2vw, 54px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .text-column p {
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.65;
  }
</style>
