---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { ueberMich } from '../content/site';
import portraitPhoto from '../assets/images/portrait.jpg';
---

<BaseLayout
  title={ueberMich.meta.title}
  description={ueberMich.meta.description}
  activePage="ueber-mich"
  lang="de"
  langSwitchHref="/en/about"
>
  <section class="header-section">
    <div class="container header-inner">
      <div class="header-text">
        <span class="eyebrow">{ueberMich.eyebrow}</span>
        <h1>{ueberMich.heading}</h1>
        <p class="lead">{ueberMich.lead}</p>
      </div>
      <div class="portrait-frame">
        <Image src={portraitPhoto} alt="Porträt von Jennifer Roth" class="portrait-photo" width={700} loading="eager" />
      </div>
    </div>
  </section>

  <section class="text-section">
    <div class="text-column">
      <div class="text-block">
        <h2>{ueberMich.motivation.heading}</h2>
        <p>{ueberMich.motivation.text}</p>
      </div>

      <div class="text-block">
        <h2>{ueberMich.praxis.heading}</h2>
        <p>{ueberMich.praxis.intro}</p>
        <ul class="praxis-list">
          {ueberMich.praxis.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="text-block">
        <h2>{ueberMich.wirkung.heading}</h2>
        {ueberMich.wirkung.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <p class="closing-line">{ueberMich.closingLine}</p>
    </div>
  </section>

  <CtaBanner
    heading={ueberMich.cta.heading}
    ctaLabel={ueberMich.cta.ctaLabel}
    ctaHref={ueberMich.cta.ctaHref}
    background="sand"
  />
</BaseLayout>

<style>
  .header-section {
    padding: var(--section-padding-y) var(--page-padding) clamp(32px, 4vw, 56px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  .header-text {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }

  .header-text h1 {
    font-size: clamp(30px, 4.2vw, 54px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 18ch;
  }

  .lead {
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 48ch;
  }

  .portrait-frame {
    min-width: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .portrait-frame :global(.portrait-photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .text-section {
    padding: 0 var(--page-padding) clamp(56px, 8vw, 110px);
  }

  .text-column {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .text-column p {
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.65;
  }

  .text-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .text-block h2 {
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .praxis-list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
  }

  .closing-line {
    padding-top: 8px;
    border-top: 1px solid var(--border-line);
    font-size: 17px !important;
    line-height: 1.6 !important;
    color: var(--ink-soft);
  }
</style>
